# Local environment example for running backend and frontend locally
# Copy this file to `.env.local` or `.env` and fill real values (DO NOT COMMIT secrets)

# MongoDB - set to your deployed MongoDB Atlas or external MongoDB URI
MONGO_URI=mongodb://<user>:<password>@cluster0.mongodb.net:27017/bpm_workflow

# Spring Boot expects SPRING_DATA_MONGODB_URI (docker-compose or app props may use this)
SPRING_DATA_MONGODB_URI=${MONGO_URI}

# IA microservice URL - set to the deployed IA microservice public endpoint
# Example: https://ia-service-241130514391.us-central1.run.app/ia
IA_SERVICE_URL=https://<your-ia-service-host>/ia

# JWT secrets for local dev (keep same value if you want existing tokens to work)
JWT_SECRET=change_this_local_secret
JWT_EXPIRATION_MS=86400000

# (Optional) GCP project for IA microservice if running it locally and needing credentials
GCP_PROJECT_ID=your-gcp-project-id
GCP_CREDENTIALS_PATH=./ia_microservice/gcp-creds.json
