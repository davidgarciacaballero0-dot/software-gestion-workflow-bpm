# ============================================================
#  PLANTILLA DE VARIABLES DE ENTORNO - BPM Workflow System
# ============================================================
#  INSTRUCCIONES:
#  1. Copiar este archivo como ".env" en la misma carpeta raíz.
#  2. Rellenar cada variable con los valores reales de tu entorno.
#  3. JAMÁS subas el archivo .env al repositorio (está en .gitignore).
# ============================================================

# --- MongoDB ---
# URI de conexión a la instancia de MongoDB.
# Para desarrollo local sin autenticación:
#   MONGO_URI=mongodb://localhost:27017/bpm_workflow
# Para Docker Compose con autenticación:
#   MONGO_URI=mongodb://root:password@mongo:27017/bpm_db?authSource=admin
MONGO_URI=mongodb://localhost:27017/bpm_workflow

# --- Credenciales de MongoDB (si se habilita autenticación) ---
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo_password

# --- JWT (JSON Web Token) ---
# Clave secreta para firmar tokens. Debe tener al menos 32 caracteres.
# Generar una clave segura con: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_KEY_WITH_OPENSSL_RAND_BASE64_64

# Tiempo de expiración del token en milisegundos (default: 86400000 = 24h)
JWT_EXPIRATION_MS=86400000

# --- Gemini AI / Vertex AI ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GCP_PROJECT_ID=workflow-smart-ia-798ae
GCP_LOCATION=us-central1

# --- Google Cloud Storage ---
GCP_STORAGE_BUCKET=bpm-documentos-adjuntos-798ae

